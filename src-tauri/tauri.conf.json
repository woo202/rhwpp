{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rhwpp",
  "mainBinaryName": "rhwpp",
  "version": "../package.json",
  "identifier": "io.github.woo202.rhwpp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob:",
        "worker-src": "'self' blob:",
        "media-src": "'self' data: blob:",
        "frame-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "rhwpp",
    "homepage": "https://github.com/woo202/rhwpp",
    "copyright": "MIT License. rhwp © Edward Kim and contributors.",
    "category": "Productivity",
    "shortDescription": "HWP/HWPX 워드프로세서",
    "longDescription": "rhwp(Rust + WebAssembly) 엔진 기반의 Windows용 HWP/HWPX/HML 문서 편집기.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "hwp"
        ],
        "name": "rhwpp.hwp",
        "description": "한글 문서 (HWP)",
        "mimeType": "application/x-hwp",
        "role": "Editor"
      },
      {
        "ext": [
          "hwpx"
        ],
        "name": "rhwpp.hwpx",
        "description": "한글 개방형 문서 (HWPX)",
        "mimeType": "application/hwp+zip",
        "role": "Editor"
      },
      {
        "ext": [
          "hml"
        ],
        "name": "rhwpp.hml",
        "description": "한글 XML 문서 (HML)",
        "mimeType": "application/xml",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "rhwpp"
      },
      "wix": {
        "language": [
          "ko-KR",
          "en-US"
        ]
      }
    }
  }
}
