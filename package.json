{
  "name": "rhwpp",
  "private": true,
  "version": "0.1.0",
  "description": "rhwp 기반 Windows용 HWP/HWPX 워드프로세서 (Tauri 데스크톱 앱)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "upstream:fetch": "node scripts/upstream.mjs fetch",
    "upstream:update": "node scripts/upstream.mjs update",
    "upstream:status": "node scripts/upstream.mjs status",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:web": "node scripts/build-web.mjs",
    "dev:web": "node scripts/build-web.mjs --dev",
    "typecheck": "tsc -p desktop/tsconfig.json",
    "test": "node --test desktop/tests/*.test.mjs",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "prepare:all": "npm run upstream:fetch && npm run build:wasm"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0"
  }
}
